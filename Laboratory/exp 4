def plural(word):
    if word.endswith(("s", "sh", "ch", "x", "z")):
        return word + "es"

    elif word.endswith("y") and word[-2] not in "aeiou":
        return word[:-1] + "ies"

    elif word.endswith("f"):
        return word[:-1] + "ves"

    else:
        return word + "s"


word = input("Enter a noun: ")

print("Singular:", word)
print("Plural:", plural(word))
