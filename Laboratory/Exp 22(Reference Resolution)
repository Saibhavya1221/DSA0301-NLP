import re

def reference_resolution(text):
    words = text.split()
    nouns = []
    
    pronouns = {
        "he", "she", "it", "they", "him", "her", "them"
    }

    print("\nReference Resolution:")
    
    for word in words:
        clean = re.sub(r'[^a-zA-Z]', '', word)
        lower = clean.lower()

        if lower in pronouns:
            if nouns:
                print(clean, "->", nouns[-1])
            else:
                print(clean, "-> No reference found")
        elif clean:
            # Store possible nouns
            if lower not in {
                "the", "a", "an", "is", "was", "are",
                "and", "or", "to", "in", "on", "of",
                "has", "have", "with"
            }:
                nouns.append(clean)

text = input("Enter a sentence: ")
reference_resolution(text)
