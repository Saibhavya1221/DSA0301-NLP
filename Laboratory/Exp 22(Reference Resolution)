import spacy

nlp = spacy.load("en_core_web_sm")

text = input("Enter text: ")
doc = nlp(text)

last_person = None

for token in doc:
    if token.pos_ == "PROPN":
        last_person = token.text

    if token.text.lower() in ["he", "she"]:
        if last_person:
            print(token.text, "refers to", last_person)
        else:
            print("Reference not found")
