
import math

documents = [
    "the cat sits on the mat",
    "the dog sits on the floor",
    "the cat likes the dog"
]

query = input("Enter search query: ").lower()


def words(text):
    return set(text.lower().split())


N = len(documents)

query_words = words(query)

scores = []

for document in documents:

    doc_words = words(document)

    score = 0

    for word in query_words:

        if word in doc_words:

            tf = document.lower().split().count(word)

            df = 0

            for d in documents:
                if word in words(d):
                    df += 1

            idf = math.log(N / df)

            score += tf * idf

    scores.append(score)


for i in range(N):
    print("Document", i + 1, "Score:", scores[i])

best = scores.index(max(scores))

print("Best matching document:")
print(documents[best])
