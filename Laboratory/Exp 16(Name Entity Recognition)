text = input("Enter text: ")

names = ["Ravi", "Priya", "John"]
places = ["Chennai", "Delhi", "Mumbai"]
organizations = ["Google", "Microsoft", "Amazon"]

words = text.split()

print("\nNamed Entities:")

for word in words:
    word = word.strip(".,!?")

    if word in names:
        print(word, "-> PERSON")
    elif word in places:
        print(word, "-> LOCATION")
    elif word in organizations:
        print(word, "-> ORGANIZATION")
