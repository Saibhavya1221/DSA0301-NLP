grammar = {
    "S": [("NP VP", 1.0)],
    "NP": [("Det N", 0.6), ("N", 0.4)],
    "VP": [("V NP", 0.7), ("V", 0.3)],
    "Det": [("the", 1.0)],
    "N": [("cat", 0.5), ("dog", 0.5)],
    "V": [("sees", 0.5), ("runs", 0.5)]
}


def parse(symbol, words, pos):

    if symbol not in grammar:

        if pos < len(words) and words[pos] == symbol:
            return 1.0, pos + 1

        return 0, pos

    best_probability = 0
    best_position = pos

    for rule, probability in grammar[symbol]:

        parts = rule.split()

        current_pos = pos
        total = probability
        valid = True

        for part in parts:

            p, new_pos = parse(part, words, current_pos)

            if p == 0:
                valid = False
                break

            total *= p
            current_pos = new_pos

        if valid and total > best_probability:
            best_probability = total
            best_position = current_pos

    return best_probability, best_position


sentence = input("Enter sentence: ").lower().split()

probability, position = parse("S", sentence, 0)

if position == len(sentence):
    print("Sentence accepted")
    print("Probability:", probability)
else:
    print("Sentence rejected")
