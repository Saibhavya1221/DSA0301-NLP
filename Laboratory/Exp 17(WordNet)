wordnet = {
    "bank": [
        "a financial institution",
        "the side of a river"
    ],

    "bat": [
        "a flying mammal",
        "a sports equipment used in baseball"
    ],

    "car": [
        "a road vehicle with four wheels"
    ],

    "python": [
        "a type of snake",
        "a programming language"
    ]
}


word = input("Enter a word: ").lower()

if word in wordnet:

    print("Word:", word)
    print("Meanings:")

    for meaning in wordnet[word]:
        print("-", meaning)

else:
    print("Word not found")
