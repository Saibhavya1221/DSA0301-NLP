dictionary = {
    "hello": "bonjour",
    "good": "bon",
    "morning": "matin",
    "goodbye": "au revoir",
    "thank": "merci",
    "you": "vous",
    "please": "s'il vous plaît",
    "yes": "oui",
    "no": "non",
    "cat": "chat",
    "dog": "chien",
    "house": "maison",
    "book": "livre",
    "school": "école",
    "student": "étudiant",
    "teacher": "professeur",
    "food": "nourriture",
    "water": "eau",
    "computer": "ordinateur",
    "i": "je",
    "am": "suis",
    "is": "est",
    "the": "le"
}


sentence = input("Enter English sentence: ").lower()

words = sentence.split()

translated = []

for word in words:

    clean = word.strip(".,!?")

    if clean in dictionary:
        translated.append(dictionary[clean])
    else:
        translated.append("[" + clean + "]")


print("French translation:")
print(" ".join(translated))
