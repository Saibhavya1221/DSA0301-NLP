import re

expression = input("Enter logical expression: ")

pattern = r'([A-Za-z]+)\(([^()]*)\)'

matches = re.findall(pattern, expression)

if matches:

    print("Valid predicate expression")

    for predicate, arguments in matches:

        print("Predicate:", predicate)
        print("Arguments:", arguments.split(","))

else:
    print("Invalid expression")
